# Local Django server (the scorize repo, ./run_local.sh). Vite proxies /api, /profile, /static, /media to it.
SCORIZE_BACKEND_URL=http://127.0.0.1:8000

# "true" builds the service worker (offline cache + install + update prompt). See docs/PWA.md.
VITE_ENABLE_PWA=false

# Dev only: "true" answers API calls from src/mocks (no Django needed).
VITE_API_MOCKS=false
