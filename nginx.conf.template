# Serves the built panel under ${PANEL_BASE} (the image's PANEL_BASE build arg): `/` on panel.scorize.com,
# `/panel/` where the site's main nginx proxies /panel/ here and everything else (/api, /static, ...) to Django.
# The image's entrypoint fills ${PANEL_BASE} in at start (nginx's templates feature).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Serve the pre-gzipped files (Dockerfile) to proxies too: nginx's proxy_pass speaks HTTP/1.0
    # by default, and gzip_static otherwise answers only HTTP/1.1 requests without a Via header,
    # so the panel went out uncompressed (~650 KB instead of ~180 KB on a first visit).
    gzip_static on;
    gzip_http_version 1.0;
    gzip_proxied any;
    gzip_vary on;
    server_tokens off;
    # Relative Location headers: behind the main nginx, an absolute one would point at :8080.
    absolute_redirect off;

    # HSTS is set where TLS ends (the site's main nginx / Django, docs/backend-changes.md A8).

    # The base without its trailing slash redirects to it (never matches when the base is `/`).
    set $uri_slash "$uri/";
    if ($uri_slash = "${PANEL_BASE}") {
        return 301 ${PANEL_BASE}$is_args$args;
    }

    location = ${PANEL_BASE}healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Hashed file names never change content: cache for a year.
    location ${PANEL_BASE}assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Must always be re-checked, or users get stuck on an old version.
    location ~ ^${PANEL_BASE}(sw\.js|workbox-.*\.js|manifest\.webmanifest)$ {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri =404;
    }

    # Client-side routes: every unknown path under the base gets the app shell.
    location ${PANEL_BASE} {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
        try_files $uri ${PANEL_BASE}index.html;
    }
}
